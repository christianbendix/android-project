# EditorConfig for the Shared Expenses Android app.
# Also the source of truth for ktlint: the ktlint_* keys below are read by the
# ktlint CLI in CI (.github/workflows/ci.yml) and by the IDE plugin.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown: two trailing spaces are a hard line break, so they must survive.
[*.md]
trim_trailing_whitespace = false

[*.{kt,kts}]
indent_size = 4
ktlint_code_style = android_studio
# @Composable functions are PascalCase by convention, which trips the
# function-naming rule. Exempt only those, not naming rules in general.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,json,xml}]
indent_size = 2

[*.gradle]
indent_size = 4

[Makefile]
indent_style = tab
