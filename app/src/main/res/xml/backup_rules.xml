<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 and lower.
   See https://developer.android.com/guide/topics/data/autobackup
   Keep in sync with data_extraction_rules.xml (Android 12+).
-->
<full-backup-content>
  <!-- The session token is encrypted with a device-bound Keystore key; it
       must never leave the device and could not be decrypted elsewhere. -->
  <exclude domain="file" path="datastore/session.preferences_pb" />
</full-backup-content>
