# =====================================================================
#  .gitignore: Shared Expenses Android App
#  Covers native Android (Kotlin/Gradle) and React Native/Expo, plus
#  Firebase, secrets, IDEs, AI tooling and OS junk.
#  NOTE: CLAUDE.md / AGENTS.md and the AI dossier MUST stay committed.
# =====================================================================


# ---------------------------------------------------------------------
# Gradle / Kotlin
# ---------------------------------------------------------------------
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/
.kotlin/
*.salive
gradle-app.setting
.gradletasknamecache


# ---------------------------------------------------------------------
# Android build output & generated files
# ---------------------------------------------------------------------
# Machine-specific SDK path
local.properties

# Packaged app files
*.apk
*.aab
*.ap_
*.apks
*.dex
*.class

# Android Studio "Generate Signed APK/Bundle" output folders
app/release/
app/debug/

# Generated / intermediate
bin/
gen/
out/
captures/
.externalNativeBuild/
.cxx/
.navigation/

# Lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Profiling dumps
*.hprof
*.trace


# ---------------------------------------------------------------------
# Signing keys (NEVER commit)
# ---------------------------------------------------------------------
*.jks
*.keystore
keystore.properties
signing.properties


# ---------------------------------------------------------------------
# Secrets & environment config
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
secrets.properties
*.pem
*.p12
*.key


# ---------------------------------------------------------------------
# Firebase
# ---------------------------------------------------------------------
# google-services.json is safe to commit (it ships inside the APK) and
# the build needs it. Uncomment only if you'd rather share it privately:
# app/google-services.json

# Admin SDK service-account keys (NEVER commit)
*service-account*.json
serviceAccountKey.json

# CLI cache & emulator logs
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
database-debug.log
ui-debug.log
pubsub-debug.log

# Crashlytics
crashlytics.properties
crashlytics-build.properties
fabric.properties
com_crashlytics_export_strings.xml


# ---------------------------------------------------------------------
# React Native / Expo / Node (harmless if you go native Kotlin)
# ---------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.yarn/cache/
.yarn/install-state.gz
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
*.jsbundle
*.tsbuildinfo
.bundle/
vendor/bundle/

# iOS folder generated by RN templates (not used, but keep it clean)
ios/Pods/
ios/build/
**/xcuserdata/
*.xcuserstate
DerivedData/


# ---------------------------------------------------------------------
# Tests & coverage
# ---------------------------------------------------------------------
coverage/
*.lcov
*.exec
.nyc_output/


# ---------------------------------------------------------------------
# IDEs & editors
# ---------------------------------------------------------------------
# Android Studio / IntelliJ (keep shared code style & inspections)
*.iml
*.ipr
*.iws
.idea/*
!.idea/codeStyles/
!.idea/inspectionProfiles/

# VS Code (keep shared recommendations)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Fleet
.fleet/

# Vim / Emacs / misc
*.swp
*.swo
*~
\#*\#
.#*
*.bak
*.tmp


# ---------------------------------------------------------------------
# AI tooling: personal/local files only
# (CLAUDE.md, AGENTS.md and .claude/settings.json ARE committed)
# ---------------------------------------------------------------------
.claude/settings.local.json
CLAUDE.local.md
.aider*


# ---------------------------------------------------------------------
# Deliverables & large media
# Demo video goes to itslearning, not git history.
# ---------------------------------------------------------------------
*.mp4
*.mov
*.mkv
*.avi
*.webm
# Office lock files
~$*


# ---------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------
*.log
logs/


# ---------------------------------------------------------------------
# OS files
# ---------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.DocumentRevisions-V100
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*
.nfs*
